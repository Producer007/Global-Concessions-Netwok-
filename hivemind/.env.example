# GCN HiveMind — testnet only. Never commit .env.
# Dry-run (default) needs none of the Hedera values. --live needs all three.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.10717267
HEDERA_OPERATOR_KEY=
# Optional: reuse the existing HCS audit topic instead of creating one per run.
HIVEMIND_TOPIC_ID=0.0.10748998

# Planner (plain-English goals → workflow). Needed only for `plan` or inputs without "workflow".
# ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to a workspace (API error mentions anthropic-workspace-id):
# ANTHROPIC_WORKSPACE_ID=

# Native HTS KYC: an HTS token with a KYC key on testnet (read-only mirror-node check).
# Use this OR KYC_REGISTRY_ADDRESS, not both. Neither set = the labelled testnet stub list.
# KYC_HTS_TOKEN_ID=0.0.xxxxx

# KYC registry contract on Hedera testnet. Unset = the labelled testnet stub list.
# Deployed GCNKYCRegistry on Hedera testnet (0.0.8285495, pre-audit):
# KYC_REGISTRY_ADDRESS=0xB503f7f03B2f40d69f5C41D728FBC956c7Ea0A68
# KYC_REGISTRY_FUNCTION=isKYCVerified(address,uint8)
# KYC_REGISTRY_TIER=2
# For scripts/approve-kyc.js --send only: ECDSA key of the registry owner (0.0.8204402). Never commit.
# KYC_ADMIN_KEY=
# HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
