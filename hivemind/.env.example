# GCN HiveMind — testnet only. Never commit .env.
# Dry-run (default) needs none of the Hedera values. --live needs all three.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.10717267
HEDERA_OPERATOR_KEY=
# Optional: reuse the existing HCS audit topic instead of creating one per run.
HIVEMIND_TOPIC_ID=0.0.10748998

# Planner (plain-English goals → workflow). Needed only for `plan` or inputs without "workflow".
# ANTHROPIC_API_KEY=

# KYC registry contract on Hedera testnet. Unset = the labelled testnet stub list.
# KYC_REGISTRY_ADDRESS=0x...
# KYC_REGISTRY_FUNCTION=isApproved(address)
# HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
